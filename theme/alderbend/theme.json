{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": { "contentSize": "42rem", "wideSize": "74rem" },
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{ "slug": "base", "name": "Cream", "color": "#f7f3ea" },
				{ "slug": "surface", "name": "Sand", "color": "#ece4d2" },
				{ "slug": "sage", "name": "Sage", "color": "#d3dccb" },
				{ "slug": "contrast", "name": "Ink", "color": "#1c2a22" },
				{ "slug": "muted", "name": "Moss ink", "color": "#46564b" },
				{ "slug": "primary", "name": "Fern", "color": "#2f5039" },
				{ "slug": "primary-dark", "name": "Deep fern", "color": "#1f3a29" },
				{ "slug": "accent", "name": "Clay", "color": "#a94a28" }
			],
			"gradients": [
				{ "slug": "dusk", "name": "Fern to ink", "gradient": "linear-gradient(160deg, var(--wp--preset--color--primary) 0%, var(--wp--preset--color--primary-dark) 100%)" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Fraunces",
					"fontFamily": "\"Fraunces\", Georgia, \"Times New Roman\", serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces-latin-wght-normal.woff2"] },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces-latin-wght-italic.woff2"] }
					]
				},
				{
					"slug": "body",
					"name": "Figtree",
					"fontFamily": "\"Figtree\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Figtree", "fontStyle": "normal", "fontWeight": "300 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/figtree-latin-wght-normal.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem)" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem)" },
				{ "slug": "xx-large", "name": "Huge", "size": "clamp(2.4rem, 1.6rem + 3.2vw, 4.4rem)" }
			]
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "1rem" },
				{ "slug": "40", "name": "3", "size": "1.5rem" },
				{ "slug": "50", "name": "4", "size": "clamp(2rem, 1.5rem + 2vw, 3rem)" },
				{ "slug": "60", "name": "5", "size": "clamp(3rem, 2rem + 4vw, 5rem)" },
				{ "slug": "70", "name": "6", "size": "clamp(4rem, 2.5rem + 6vw, 8rem)" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Soft", "shadow": "0 1px 2px rgba(28, 42, 34, 0.08), 0 8px 24px -12px rgba(28, 42, 34, 0.25)" }
			]
		},
		"custom": {
			"radius": { "card": "1.25rem", "pill": "999px" },
			"line": "1px solid color-mix(in srgb, var(--wp--preset--color--contrast) 16%, transparent)"
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" }
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--accent)" } },
				":focus-visible": { "outline": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "3px", "offset": "3px" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--primary-dark)" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "560", "lineHeight": "1.12", "letterSpacing": "-0.015em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "700" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" },
				"typography": { "fontWeight": "650", "textDecoration": "none" },
				"border": { "radius": "var(--wp--custom--radius--pill)" },
				"spacing": { "padding": { "top": "0.85rem", "bottom": "0.85rem", "left": "1.6rem", "right": "1.6rem" } },
				":hover": { "color": { "background": "var(--wp--preset--color--accent)", "text": "#ffffff" } },
				":focus-visible": { "outline": { "color": "var(--wp--preset--color--accent)", "style": "solid", "width": "3px", "offset": "3px" } }
			}
		},
		"blocks": {
			"core/site-title": { "typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "620", "fontSize": "1.3rem", "letterSpacing": "-0.01em" }, "elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "var(--wp--preset--color--primary-dark)" } } } },
			"core/navigation": { "typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }, "elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "var(--wp--preset--color--contrast)" }, ":hover": { "typography": { "textDecoration": "underline" }, "color": { "text": "var(--wp--preset--color--accent)" } } } } },
			"core/post-title": { "elements": { "link": { "typography": { "textDecoration": "none" }, "color": { "text": "var(--wp--preset--color--primary-dark)" } } } },
			"core/post-date": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" }, "color": { "text": "var(--wp--preset--color--muted)" } },
			"core/image": { "border": { "radius": "var(--wp--custom--radius--card)" } },
			"core/post-featured-image": { "border": { "radius": "var(--wp--custom--radius--card)" } },
			"core/separator": { "border": { "color": "color-mix(in srgb, var(--wp--preset--color--contrast) 18%, transparent)" } },
			"core/details": { "border": { "bottom": { "color": "color-mix(in srgb, var(--wp--preset--color--contrast) 18%, transparent)", "width": "1px", "style": "solid" } }, "spacing": { "padding": { "top": "1rem", "bottom": "1rem" } } },
			"core/query-pagination": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } }
		},
		"css": ".wp-site-blocks > * + * { margin-block-start: 0; } :where(.wp-site-blocks) > footer { margin-block-start: 0; } a:where(:not(.wp-element-button)) { text-underline-offset: 0.2em; text-decoration-thickness: 1px; }"
	},
	"customTemplates": [
		{ "name": "page-wide", "title": "Wide page, no title", "postTypes": ["page"] }
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
